+:root[data-theme="dark"] .notice.warn{background:#3a3418;border-color:#6d6330;color:#f3e2a0}
+:root[data-theme="dark"] .notice.error{background:#3d2220;border-color:#7a403b;color:#ffd3cc}
+:root[data-theme="dark"] .tag.example{background:#2d4a3b;border-color:#52695a}
