+.intro-strip span{max-width:300px;line-height:1.4}
+.intro-strip b{display:block;font-weight:400;font-size:clamp(26px,3vw,36px);letter-spacing:-.03em;margin-bottom:4px}
+.intro-strip a{color:inherit;border-bottom:1px solid #f4f2e980;padding:8px 0;align-self:center}
+.eyebrow,.section-label{font-family:var(--mono);font-size:.9rem}
+@media(max-width:700px){
+ #theme-toggle{top:8px;right:8px;padding:9px 12px;min-height:44px}
