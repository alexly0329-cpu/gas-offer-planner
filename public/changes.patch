+
+/* theme toggle: pinned to the top-right corner on every scroll position */
+#theme-toggle{position:fixed;top:12px;right:12px;z-index:60;display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:10px 16px;font:500 1rem var(--font);letter-spacing:normal;background:#172c26;color:#f4f2e9;border:1px solid #f4f2e9a0;box-shadow:0 4px 14px #0005;border-radius:0;clip-path:none}
+#theme-toggle:hover{background:#e9fc82;color:#172720;border-color:#e9fc82}
+#theme-toggle:focus-visible{outline:3px solid #e9fc82;outline-offset:3px}
